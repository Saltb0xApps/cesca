# --- Notion ---
# 1. Create an integration: https://www.notion.so/profile/integrations
# 2. Copy the "Internal Integration Secret" here.
# 3. Share the parent page (and any per-account DBs you create later) with the integration.
NOTION_TOKEN=

# Parent page ID where `npm run setup:notion` will create databases.
# Open the page in Notion, copy the URL, the last 32-char hex chunk is the ID.
NOTION_PARENT_PAGE_ID=

# Optional: page ID of a "Cesca Token Store" page where rotating LinkedIn
# tokens are persisted. If unset, tokens won't auto-refresh on Vercel.
# Create it with: npm run setup:tokens
NOTION_TOKEN_STORE_PAGE_ID=

# --- Accounts (multi-account mode) ---
# JSON array. Each entry pairs one Notion database with the credentials it
# should publish under. Add one entry per LinkedIn profile or company page.
#
# To onboard a new account:
#   1. npm run setup:notion -- <account-name>     (creates a dedicated DB)
#   2. npm run oauth:linkedin <account-name>      (does OAuth, prints entry)
#   3. paste the entry into the ACCOUNTS array, set notionDatabaseId
#
# Example (single line; JSON doesn't allow comments, so escape newlines):
# ACCOUNTS=[{"name":"personal","notionDatabaseId":"...","linkedin":{"accessToken":"...","refreshToken":"...","expiresAt":"...","authorUrn":"urn:li:person:..."}},{"name":"my-startup","notionDatabaseId":"...","linkedin":{"accessToken":"...","refreshToken":"...","expiresAt":"...","authorUrn":"urn:li:organization:..."}}]
ACCOUNTS=

# --- Legacy single-account mode (still works if ACCOUNTS is empty) ---
# Filled in by `npm run setup:notion` when no account name is given.
NOTION_DATABASE_ID=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_TOKEN_EXPIRES_AT=
LINKEDIN_AUTHOR_URN=

# --- LinkedIn app credentials (shared across all accounts) ---
# 1. Create an app: https://www.linkedin.com/developers/apps
# 2. Products: "Sign In with LinkedIn using OpenID Connect", "Share on LinkedIn",
#    and "Marketing Developer Platform" (the last unlocks w_organization_social
#    for company pages).
# 3. Authorized redirect URL: http://localhost:5173/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Cron auth (Vercel sets this for cron jobs; same value used as bearer to protect /api/cron) ---
CRON_SECRET=

# --- Substack (no posting API; we only generate a draft link) ---
# Your publication subdomain, e.g. "mynewsletter" for mynewsletter.substack.com
SUBSTACK_PUBLICATION=

# --- Instagram / TikTok / YouTube (stubs for now — see src/platforms/*.ts) ---

# --- Telegram notifications ---
# 1. Message @BotFather on Telegram, send /newbot, follow prompts, copy the token.
# 2. Send your bot any message to start the chat.
# 3. Run `npm run setup:telegram` to fetch and print your chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Dashboard ---
# Shared password for the dashboard. Anything non-empty is fine.
DASHBOARD_PASSWORD=
