# --- Notion ---
# 1. Create an integration: https://www.notion.so/profile/integrations
# 2. Copy the "Internal Integration Secret" here.
# 3. Share your workspace (or a parent page) with the integration so it can create the DB.
NOTION_TOKEN=

# Parent page ID where `npm run setup:notion` will create the database.
# Open the page in Notion, copy the URL, the last 32-char hex chunk is the ID.
NOTION_PARENT_PAGE_ID=

# Filled in automatically by `npm run setup:notion`.
NOTION_DATABASE_ID=

# --- Cron auth (Vercel sets this for cron jobs; same value used as bearer to protect /api/cron) ---
CRON_SECRET=

# --- LinkedIn ---
# 1. Create an app: https://www.linkedin.com/developers/apps
# 2. Add the "Share on LinkedIn" and "Sign In with LinkedIn using OpenID Connect" products.
# 3. Set Authorized redirect URL to http://localhost:5173/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Filled in by `npm run oauth:linkedin`.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_TOKEN_EXPIRES_AT=
# Your member URN, e.g. urn:li:person:abc123 — filled by the oauth script.
LINKEDIN_AUTHOR_URN=

# --- Substack (no posting API; we only generate a draft link) ---
# Your publication subdomain, e.g. "mynewsletter" for mynewsletter.substack.com
SUBSTACK_PUBLICATION=

# --- Instagram / TikTok / YouTube (stubs for now — see src/platforms/*.ts) ---

# --- Telegram notifications ---
# 1. Message @BotFather on Telegram, send /newbot, follow prompts, copy the token.
# 2. Send your bot any message to start the chat.
# 3. Run `npm run setup:telegram` to fetch and print your chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Dashboard ---
# Shared password for the dashboard. Anything non-empty is fine.
DASHBOARD_PASSWORD=
