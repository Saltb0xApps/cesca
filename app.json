{
  "expo": {
    "name": "PomoLeague",
    "slug": "pomoleague",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "pomoleague",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cesca.pomoleague"
    },
    "android": {
      "package": "com.cesca.pomoleague"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "supabaseUrl": "",
      "supabaseAnonKey": ""
    }
  }
}
