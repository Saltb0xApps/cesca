{
  "name": "margins",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Margins — a writing studio for essays, with side-margin editing in the spirit of Wolfgang Weingart.",
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node server/index.js",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "margins": "npm run build && npm start",
    "autostart": "npm run build && bash scripts/install-autostart.sh",
    "icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "express": "^4.19.2",
    "marked": "^12.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "sharp": "^0.35.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
